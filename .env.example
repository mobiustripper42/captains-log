# Captain's Log — environment template. Copy to .env and fill in.
# .env is gitignored. Never commit real secrets.

# ── Telegram ──────────────────────────────────────────────────────────────
# Create a bot via @BotFather in Telegram — it gives you the token.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret token you configure when registering the webhook URL with Telegram.
# Arbitrary string you choose; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token.
# Generate with: openssl rand -hex 32
TELEGRAM_SECRET_TOKEN=your-secret-token-here

# ── Anthropic ─────────────────────────────────────────────────────────────
# Direct Anthropic SDK (DEC-008). Issue at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Sheets (DEC-009) ───────────────────────────────────────────────
# Path to the GCP service-account JSON key (relative to repo root or absolute).
# Sheet must be shared with the service-account email as Editor.
GOOGLE_SERVICE_ACCOUNT_KEY=./google-service-account.json
# The "Captains Log All (Responses)" Sheet ID (from the URL between /d/ and /edit)
GOOGLE_SHEET_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Worksheet (tab) name within the Sheet. Form-response default is "Form Responses 1".
# For dev / mill-dev testing, point at a separate tab (e.g. "Test Responses") in the same Sheet.
SHEETS_WORKSHEET_TITLE=Form Responses 1
# Cron schedule for the async Sheet sync job (2.5). Default every 5 minutes.
# Set SHEETS_SYNC_DISABLED=1 to turn off the sync cron (e.g. local dev).
SHEETS_SYNC_CRON=*/5 * * * *
SHEETS_SYNC_DISABLED=0

# ── Email digest (DEC-005) ────────────────────────────────────────────────
# Gmail SMTP, app password (NOT your account password).
# https://myaccount.google.com/apppasswords
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
DIGEST_RECIPIENT=eric@stoffer.net

# ── Weather (3.5) ─────────────────────────────────────────────────────────
# Open-Meteo is keyless. Lat/lon for Brewboat's home location (Cleveland default).
WEATHER_LAT=41.4993
WEATHER_LON=-81.6944

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
# 'info' | 'debug'
LOG_LEVEL=info
# IANA tz for ET → cron + day-bucketing
TIMEZONE=America/New_York

# ── Behavior toggles ──────────────────────────────────────────────────────
# How to handle inbound messages from an unregistered chat_id:
#   reply  — send the "not registered" auto-reply (default)
#   silent — log raw, no reply
UNKNOWN_SENDER=reply
# DEV ONLY. Set to 1 to skip Telegram secret-token validation when testing
# locally with curl (no real Telegram request). NEVER enable in production.
TELEGRAM_SKIP_SECRET=0
