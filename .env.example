# Captain's Log — environment template. Copy to .env and fill in.
# .env is gitignored. Never commit real secrets.

# ── Twilio ────────────────────────────────────────────────────────────────
# From Twilio Console → Account → API keys & tokens
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# E.164 toll-free number you provisioned (starts with +1)
TWILIO_PHONE_NUMBER=+18445551234

# ── Anthropic ─────────────────────────────────────────────────────────────
# Direct Anthropic SDK (DEC-008). Issue at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Sheets (DEC-009) ───────────────────────────────────────────────
# Path to the GCP service-account JSON key (relative to repo root or absolute).
# Sheet must be shared with the service-account email as Editor.
GOOGLE_SERVICE_ACCOUNT_KEY=./google-service-account.json
# The "Captains Log All (Responses)" Sheet ID (from the URL between /d/ and /edit)
GOOGLE_SHEET_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Tab name within the Sheet that the Google Form writes to (usually "Form Responses 1")
GOOGLE_SHEET_TAB=Form Responses 1

# ── Email digest (DEC-005) ────────────────────────────────────────────────
# Gmail SMTP, app password (NOT your account password).
# https://myaccount.google.com/apppasswords
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
DIGEST_RECIPIENT=eric@stoffer.net

# ── Weather (3.5) ─────────────────────────────────────────────────────────
# Open-Meteo is keyless. Lat/lon for Brewboat's home location (Cleveland default).
WEATHER_LAT=41.4993
WEATHER_LON=-81.6944

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
# 'info' | 'debug'
LOG_LEVEL=info
# IANA tz for ET → cron + day-bucketing
TIMEZONE=America/New_York

# ── Behavior toggles ──────────────────────────────────────────────────────
# How to handle inbound SMS from a phone not in captains.json:
#   reply  — send the "not registered" auto-reply (default; helpful for fat-finger errors)
#   silent — log raw, no reply (lower spam-confirmation surface)
UNKNOWN_SENDER=reply
# DEV ONLY. Set to 1 to skip Twilio signature validation when testing locally
# without a real Twilio request (e.g. curl). NEVER enable in production.
TWILIO_SKIP_SIGNATURE=0
